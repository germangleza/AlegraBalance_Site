---
import { site } from "../../site.config.js";
import { jsonLdBase, breadcrumbJsonLd } from "../lib/schema.js";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileCta from "../components/MobileCta.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const {
  slug = "/",
  title,
  description,
  active = slug,
  breadcrumbs = null,
  jsonLd = [],
  noindex = false,
  ogType = "website",
  ogImage: ogImageProp,
  bare = false,
} = Astro.props;

const canonical = site.baseUrl + slug;
const ogImage = ogImageProp || site.baseUrl + "/assets/og-default.png";

const schemas = [...jsonLdBase(), ...jsonLd];
const bc = breadcrumbJsonLd(breadcrumbs);
if (bc) schemas.push(bc);
---
<!DOCTYPE html>
<html lang="es-MX">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex
  ? <meta name="robots" content="noindex, follow" />
  : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
<link rel="canonical" href={canonical} />
<meta name="author" content={site.doctor.name} />
<meta name="publisher" content={site.brand.name} />
<meta name="geo.region" content="MX-CMX" />
<meta name="geo.placename" content="Roma Norte, Ciudad de México" />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.brand.name} />
<meta property="og:locale" content="es_MX" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={`${site.brand.name} — ${site.brand.tagline}`} />
{!ogImageProp && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="theme-color" content="#071E55" />
<script is:inline>document.documentElement.classList.add('js','intro-play');</script>
<link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon-48.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Karla:wght@400;500;700&family=IBM+Plex+Mono:wght@500&display=swap" />
<link rel="stylesheet" href="/css/styles.css" />
{schemas.map((s) => <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />)}
</head>
<body class={bare ? "bare" : undefined}>
{!bare && (
  <>
    <a href="#main" class="skip-link">Saltar al contenido</a>
    <div class="scroll-sentinel" aria-hidden="true"></div>
    <Header active={active} />
  </>
)}
<main id="main">
{!bare && breadcrumbs && <Breadcrumbs trail={breadcrumbs} />}
<slot />
</main>
{!bare && (
  <>
    <Footer />
    <MobileCta />
  </>
)}
{!bare && <script is:inline src="/js/main.js" defer></script>}
</body>
</html>
