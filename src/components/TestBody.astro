---
import Media from "./Media.astro";
import ScheduleButton from "./ScheduleButton.astro";
import Faq from "./Faq.astro";
import Reviewer from "./Reviewer.astro";
import CtaBand from "./CtaBand.astro";
import RelatedCards from "./RelatedCards.astro";
const { d } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    <div class={`page-hero__grid${d.img ? "" : " page-hero__grid--single"}`}>
      <div>
        <span class="eyebrow">Evaluación especializada</span>
        <h1>{d.title}</h1>
        <p set:html={d.summary} />
        <ScheduleButton loc={"detalle-" + d.id} />
      </div>
      {d.img && <div class="page-hero__media"><Media label={d.image || d.title} src={d.img} /></div>}
    </div>
  </div>
</section>

<section class="section bg-papel">
  <div class="container">
    <div class="answer-block reveal" style="max-width:820px" set:html={d.answer || d.summary} />
  </div>
</section>

<section class="section bg-papel" style="padding-top:0">
  <div class="container">
    <div class="feature" style="align-items:start">
      <div class="reveal"><span class="eyebrow">¿Qué es?</span><h2>En qué consiste</h2><p class="text-muted">{d.whatIsIt}</p></div>
      <div class="reveal"><span class="eyebrow">¿Para qué sirve?</span><h2>Qué puede aportar</h2><p class="text-muted">{d.whatIsItFor}</p></div>
    </div>
  </div>
</section>

<section class="section bg-gasa">
  <div class="container">
    <div class="feature" style="align-items:start">
      <div class="reveal"><span class="eyebrow">¿Cómo se realiza?</span><h2>El procedimiento</h2><p class="text-muted">{d.howItIsDone}</p></div>
      <div class="reveal">
        <span class="eyebrow">Preparación</span>
        <h2>Antes de la prueba</h2>
        <ul class="check-list">{d.preparation.map((i) => <li>{i}</li>)}</ul>
        {d.ageNotes && <p class="text-muted" style="margin-top:1rem">{d.ageNotes}</p>}
      </div>
    </div>
  </div>
</section>

<section class="section bg-papel">
  <div class="container">
    <div class="section-head"><span class="eyebrow">Atención integral</span><h2>Padecimientos relacionados</h2><p>Esta prueba se indica de acuerdo con la sospecha clínica. Puede formar parte del estudio de:</p></div>
    <div style="margin-top:2rem"><RelatedCards items={d.related} /></div>
  </div>
</section>

{d.faq && d.faq.length > 0 && (
  <section class="section bg-gasa"><div class="container"><div class="section-head center"><h2>Preguntas frecuentes</h2></div><div style="margin-top:2rem"><Faq items={d.faq} /></div></div></section>
)}

<section class="section bg-papel"><div class="container"><div style="max-width:820px;margin-inline:auto"><Reviewer /></div></div></section>

<CtaBand
  h2="La prueba correcta depende de una valoración adecuada"
  text="Agenda una consulta para determinar qué estudios pueden ser útiles en tu caso."
  loc={"detalle-" + d.id + "-final"}
/>
