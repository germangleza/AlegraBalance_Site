---
import { ICONS } from "../lib/icons.js";
const { name, class: cls } = Astro.props;
const path = ICONS[name] || "";
---
<svg class={`icon${cls ? " " + cls : ""}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={path} />
