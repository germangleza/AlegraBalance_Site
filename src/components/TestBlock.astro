---
import Icon from "./Icon.astro";
import Media from "./Media.astro";
import ScheduleButton from "./ScheduleButton.astro";
import GhostLink from "./GhostLink.astro";
const { id, icon, h, rows, detailHref, img } = Astro.props;
---
<section class="section bg-papel" id={id}>
  <div class="container">
    <div class="feature">
      <div class="reveal">
        <div class="card__icon"><Icon name={icon} /></div>
        <h2>{h}</h2>
        <div class="article" style="margin:1rem 0 0">{rows.map((r) => (<Fragment><h3>{r.q}</h3><p>{r.a}</p></Fragment>))}</div>
        <div class="btn-row" style="margin-top:1.4rem"><ScheduleButton loc={id} />{detailHref && <GhostLink href={detailHref} label="Ver detalle completo" />}</div>
      </div>
      <div class="feature__media reveal"><Media label={h} src={img} /></div>
    </div>
  </div>
</section>
